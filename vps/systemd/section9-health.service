[Unit]
Description=Section 9 health run: build and test the five repos, rewrite the Health run issue
Documentation=https://github.com/petterfranzen/agent-manager/blob/main/docs/RUNBOOK.md
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# vps/health.sh: the builds run in a sandbox-image container with no token in it
# at all; a second one, which builds nothing, posts the table with the agents' own
# GH_TOKEN (/etc/section9/sandbox.env). The five repos are public, so the clones need
# no token. The sandbox service's own cpus/mem_limit/pids_limit bound the run.
ExecStart=/opt/agent-manager/vps/health.sh
TimeoutStartSec=45min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
# full, not strict: docker compose may (re)build the image and keep state in /root/.docker.
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# Only the Docker socket and root-owned files: the owner needs no capability.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
