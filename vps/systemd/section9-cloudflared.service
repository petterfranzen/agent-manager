[Unit]
Description=Section 9 patch rule: upgrade cloudflared only once its release is 24 h old
Documentation=https://github.com/petterfranzen/agent-manager/blob/main/docs/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/agent-manager/vps/cloudflared-patch.sh
TimeoutStartSec=5min
Nice=10
# apt and dpkg write across the filesystem (and packages may ship setuid files), so
# unlike the read-only units this one carries no ProtectSystem or RestrictSUIDSGID; the
# script itself is small and in the sync's protected set. What follows leaves apt and dpkg alone.
StateDirectory=section9
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
