[Unit]
Description=Section 9 code health: join the run ledger with the PRs' Code Health lines, weekly
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/agent-manager/vps/dispatch.py code-health
TimeoutStartSec=10min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
StateDirectory=section9
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
