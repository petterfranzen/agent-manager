[Unit]
Description=Book OpenRouter's real spend in Paperclip per agent (daily summary on the Spend issue)
Documentation=https://github.com/petterfranzen/agent-manager/blob/main/docs/RUNBOOK.md
After=network-online.target docker.service
Wants=network-online.target agent-manager-crew-status.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/sbin/agent-manager-spend
TimeoutStartSec=5min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/agent-manager
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
