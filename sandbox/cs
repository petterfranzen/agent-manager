#!/bin/sh
# CodeScene's `cs` CLI with the agents' token. SSH sessions don't get the
# container's environment, so the entrypoint leaves the token in a 0600 file
# (as it does for git and gh) and this hands it to the real binary. Without a
# token `cs version` and `cs --help` still work; `cs review` says it needs one.
token_file="${CS_TOKEN_FILE:-$HOME/.config/codescene/token}"
if [ -z "${CS_ACCESS_TOKEN:-}" ] && [ -r "$token_file" ]; then
  CS_ACCESS_TOKEN=$(cat "$token_file")
  export CS_ACCESS_TOKEN
fi
# The image pins the version; no "a newer cs is out" call home on every run.
export CS_DISABLE_VERSION_CHECK=1
exec "${CS_BIN:-/usr/local/lib/codescene/cs}" "$@"
