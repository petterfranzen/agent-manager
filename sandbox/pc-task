#!/usr/bin/env python3
"""Report on your own Paperclip issues from the sandbox.

Usage:
  pc-task --as <agent> mine
  pc-task --as <agent> comment <issue> <text | ->
  pc-task --as <agent> status <issue> <status> [<text | ->]

<agent> is your name (Batou, Tachikoma, ...), or set PC_AGENT. <issue> is the
identifier from your task, e.g. SEC-8. "-" reads the text from stdin.
Statuses: todo, in_progress, in_review, done, blocked, cancelled.

Each agent has a task_bridge key (mounted read-only at /run/paperclip-keys) that
can read, comment on and set the status of issues assigned to that agent, and
nothing else. The key is never printed. A Python port of the commands we use
from Paperclip's own paperclip-task-bridge helper (MIT, tag v2026.1023.0).
"""

import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request

API = os.environ.get("PAPERCLIP_API_URL", "http://paperclip:3100").rstrip("/") + "/api"
KEYS = "/run/paperclip-keys"
STATUSES = {"todo", "in_progress", "in_review", "done", "blocked", "cancelled"}


def fail(msg, code=2):
    print(f"pc-task: {msg}", file=sys.stderr)
    sys.exit(code)


def key_for(agent):
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9-]{0,40}", agent or ""):
        fail("say who you are: --as <agent name>, or set PC_AGENT")
    try:
        with open(f"{KEYS}/{agent.lower()}.key") as f:
            return f.read().strip()
    except OSError:
        fail(f"no Paperclip key for {agent}; tell the Major")


def call(key, method, path, body=None):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(API + path, data=data, method=method)
    req.add_header("Authorization", "Bearer " + key)
    req.add_header("Accept", "application/json")
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            raw = resp.read()
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "replace").replace(key, "[key]")[:300]
        fail(f"{method} {path} -> {e.code}: {detail}", 1)
    except (urllib.error.URLError, OSError) as e:
        fail(f"{method} {path} -> no response: {getattr(e, 'reason', e)}", 1)
    return json.loads(raw) if raw.strip() else None


def text_arg(value):
    text = sys.stdin.read() if value == "-" else value
    if not text or not text.strip():
        fail("empty text")
    return text


def summary(issue):
    return {k: issue.get(k) for k in ("identifier", "title", "status")}


def main(argv):
    agent = os.environ.get("PC_AGENT")
    if len(argv) >= 2 and argv[0] == "--as":
        agent, argv = argv[1], argv[2:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, args = argv[0], argv[1:]
    key = key_for(agent)
    if cmd == "mine" and not args:
        issues = call(key, "GET", "/agents/me/inbox-lite") or []
        for issue in issues:
            print(json.dumps(summary(issue)))
    elif cmd == "comment" and len(args) == 2:
        call(key, "POST", f"/issues/{urllib.parse.quote(args[0], safe='')}/comments",
             {"body": text_arg(args[1])})
        print(f"commented on {args[0]}")
    elif cmd == "status" and len(args) in (2, 3):
        if args[1] not in STATUSES:
            fail(f"status must be one of: {', '.join(sorted(STATUSES))}")
        body = {"status": args[1]}
        if len(args) == 3:
            body["comment"] = text_arg(args[2])
        issue = call(key, "PATCH", f"/issues/{urllib.parse.quote(args[0], safe='')}", body)
        print(json.dumps(summary(issue or {})))
    else:
        fail("unknown command or wrong arguments; see pc-task --help")


if __name__ == "__main__":
    main(sys.argv[1:])
