#!/usr/bin/env bash
# shoot <url-or-file> <out.png> [--mobile] [--full]
#
# Screenshots a page in headless Chromium and lists its console errors,
# uncaught exceptions, failed requests and sideways overflow. Desktop is
# 1280x800; --mobile is a 390x844 phone with touch; --full takes the whole page
# instead of the first screen. A file or folder argument opens its index.html.
#
# The VM is small and shared with flight-tracker, so only one browser runs at a
# time: a second shoot waits for the first (up to 5 minutes). Anything else that
# starts a browser should take the same lock:  flock /tmp/browser.lock <command>
set -euo pipefail

case "${1:-}" in -h|--help|"") sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac

export PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright NODE_PATH=/usr/local/lib/node_modules

exec 9>/tmp/browser.lock
if ! flock -n 9; then
  echo "shoot: another browser is running; waiting for it (up to 5 min)" >&2
  flock -w 300 9 || { echo "shoot: still busy after 5 min; try again later" >&2; exit 75; }
fi
# timeout signals the whole process group, so Chromium's children go too.
exec timeout -k 5 90 nice -n 10 node /usr/local/lib/shoot/shoot.cjs "$@"
